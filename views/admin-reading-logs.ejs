<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reading Logs | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="page page-wide">
    <header class="site-header">
      <div class="auth-bar">
        <div id="authStatus" class="auth-status"></div>
      </div>
      <h1>Reading Progress</h1>
      <p class="subtitle">Log your reading sessions and track your own progress.</p>
    </header>

    <section class="card">
      <h2 id="logFormTitle">Log a Reading Session</h2>
      <form id="logForm" class="admin-form">
        <input type="hidden" id="logFormId">
        <input type="hidden" id="logGenre">
        <input type="hidden" id="logCompletionPercent">

        <div class="form-group">
          <label for="logBookId">Book</label>
          <select id="logBookId" required>
            <option value="">Select a book...</option>
          </select>
        </div>

        <div class="form-group">
          <label for="logDate">Date</label>
          <input type="date" id="logDate" required>
        </div>

        <div class="form-group">
          <label for="logPagesRead">Pages Read This Session</label>
          <input type="number" id="logPagesRead" min="0" required>
        </div>

        <div class="form-group">
          <label for="logMinutes">Minutes Spent Reading</label>
          <input type="number" id="logMinutes" min="1" required>
        </div>

        <div class="form-group">
          <label for="logRating">Rating (optional)</label>
          <input type="number" id="logRating" min="0" max="5">
        </div>

        <div id="completionFeedback" class="completion-feedback"></div>

        <div class="form-actions">
          <button type="submit" class="btn-primary" id="logFormSubmit">Save Session</button>
          <button type="button" class="btn-secondary" id="logFormCancel" style="display:none;">Cancel Edit</button>
        </div>
      </form>
      <div id="logFormStatus" class="status-area"></div>
    </section>

    <section class="card">
      <h2>My Reading Sessions</h2>

      <div class="admin-list-controls">
        <div class="control-group">
          <label for="logCompletionFilter">Completion</label>
          <select id="logCompletionFilter">
            <option value="">All Sessions</option>
            <option value="true">Completed a Book</option>
            <option value="false">In Progress</option>
          </select>
        </div>
        <div class="control-group">
          <label for="logSortFilter">Sort by</label>
          <select id="logSortFilter">
            <option value="-date">Newest First</option>
            <option value="date">Oldest First</option>
            <option value="-pagesRead">Most Pages Read</option>
            <option value="-minutes">Most Time Spent</option>
          </select>
        </div>
        <div class="control-group control-group-search">
          <label for="logSearchFilter">Search by book title</label>
          <input type="text" id="logSearchFilter" placeholder="e.g. Dune">
        </div>
      </div>

      <div id="adminLogsStatus" class="status-area"></div>
      <div id="adminLogsList" class="admin-table"></div>
    </section>

    <nav class="site-nav">
      <a href="/search">Discover</a>
      <a href="/admin/books">Book Catalogue</a>
      <a href="/admin/reading-logs">Reading Logs</a>
      <a href="/admin/reviews">Reviews</a>
      <a href="/admin/shelves">Shelves</a>
      <a href="/dashboard">Dashboard</a>
    </nav>
  </div>


  <script src="/js/authFetch.js"></script>
  <script src="/js/navGate.js"></script>
  <script src="/js/authStatus.js"></script>
  <script src="/js/admin-reading-logs.js"></script>
</body>
</html>