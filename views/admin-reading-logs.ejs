<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reading Logs | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="page page-wide">
    <header class="site-header">
      <h1>📓 Reading Logs</h1>
      <p class="subtitle">All recorded reading sessions.</p>
    </header>

    <div class="admin-list-controls">
      <div class="control-group">
        <label for="logCompletionFilter">Completion</label>
        <select id="logCompletionFilter">
          <option value="">All Sessions</option>
          <option value="true">Completed a Book</option>
          <option value="false">In Progress</option>
        </select>
      </div>
      <div class="control-group">
        <label for="logSortFilter">Sort by</label>
        <select id="logSortFilter">
          <option value="-date">Newest First</option>
          <option value="date">Oldest First</option>
          <option value="-pagesRead">Most Pages Read</option>
          <option value="-minutes">Most Time Spent</option>
        </select>
      </div>
      <div class="control-group control-group-search">
        <label for="logSearchFilter">Search by book title</label>
        <input type="text" id="logSearchFilter" placeholder="e.g. Dune">
      </div>
    </div>

    <div id="adminLogsStatus" class="status-area"></div>
    <div id="adminLogsList" class="admin-table"></div>

    <nav class="site-nav">
      <a href="/">Reading Plan</a>
      <a href="/reading-tips">Reading Tips</a>
      <a href="/search">Discover</a>
      <a href="/admin/reading-logs">Reading Logs</a>
    </nav>
  </div>

  <script src="/js/admin-reading-logs.js"></script>
</body>
</html>