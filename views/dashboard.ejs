<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Analytics Dashboard | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
</head>
<body>
  <div class="page page-wide">
    <header class="site-header">
      <div class="auth-bar">
        <div id="authStatus" class="auth-status"></div>
      </div>
      <h1>📊 Analytics Dashboard</h1>
      <p class="subtitle">Your reading habits, visualized.</p>
    </header>

    <div class="admin-list-controls">
      <div class="control-group">
        <label for="dateRangePreset">Date Range</label>
        <select id="dateRangePreset">
          <option value="7">Last 7 Days</option>
          <option value="30" selected>Last 30 Days</option>
          <option value="365">This Year</option>
          <option value="all">All Time</option>
        </select>
      </div>
    </div>

    <div id="dashboardStatus" class="status-area"></div>

    <div class="metrics-grid" id="metricsGrid"></div>

    <div class="chart-grid">
      <div class="card chart-card">
        <div class="chart-card-header">
          <h2>Pages Over Time</h2>
          <p class="chart-card-subtitle">Daily pages read across the selected range</p>
        </div>
        <div class="chart-canvas-wrap">
          <canvas id="pagesOverTimeChart"></canvas>
        </div>
      </div>

      <div class="card chart-card">
        <div class="chart-card-header">
          <h2>Reading by Genre</h2>
          <p class="chart-card-subtitle">Sessions logged per genre</p>
        </div>
        <div class="chart-canvas-wrap">
          <canvas id="genreChart"></canvas>
        </div>
      </div>

      <div class="card chart-card">
        <div class="chart-card-header">
          <h2>Completion Status</h2>
          <p class="chart-card-subtitle">Share of sessions that finished a book</p>
        </div>
        <div class="chart-canvas-wrap">
          <canvas id="completionChart"></canvas>
        </div>
      </div>

      <div class="card chart-card">
        <div class="chart-card-header">
          <h2>Reading Calendar</h2>
          <p class="chart-card-subtitle">Last 14 days — darker squares mean more pages read</p>
        </div>
        <div id="calendarSummary" class="calendar-summary"></div>
      </div>
    </div>

    <div class="card chart-card">
      <div class="chart-card-header">
        <h2>Pages by Day of Week</h2>
        <p class="chart-card-subtitle">Which weekdays you read the most</p>
      </div>
      <div class="chart-canvas-wrap">
        <canvas id="heatmapChart"></canvas>
      </div>
    </div>

    <nav class="site-nav">
      <a href="/search">Discover</a>
      <a href="/admin/books">Book Catalogue</a>
      <a href="/admin/reading-logs">Reading Logs</a>
      <a href="/admin/reviews">Reviews</a>
      <a href="/admin/shelves">Shelves</a>
      <a href="/dashboard">Dashboard</a>
    </nav>
  </div>

  <script src="/js/authFetch.js"></script>
  <script src="/js/navGate.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/authStatus.js"></script>
</body>
</html>