<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Author Info | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
</head>
<body>
  <div class="page page-wide">
    <header class="site-header">
      <h1>✍️ Author Info</h1>
      <p class="subtitle">Search for an author, then read their biography in your language.</p>
    </header>

    <form id="authorSearchForm" class="book-search-bar">
      <input type="text" id="authorSearchInput" placeholder="e.g. Isaac Asimov" required>
      <button type="submit" class="btn-primary">Search</button>
    </form>

    <div class="language-bar language-bar-inline">
      <label for="languageSelect">Biography language</label>
      <select id="languageSelect">
        <% SUPPORTED_LANGUAGES.forEach(function(lang) { %>
          <option value="<%= lang.code %>"><%= lang.name %></option>
        <% }); %>
      </select>
    </div>

    <div id="authorSearchStatus" class="status-area"></div>
    <div id="authorCandidates" class="candidate-list"></div>

    <div id="authorBioStatus" class="status-area"></div>
    <div id="authorBio"></div>

    <nav class="site-nav">
      <a href="/search">Discover</a>
      <a href="/">Reading Plan</a>
    </nav>
  </div>

  <script src="/js/authors-search.js"></script>
</body>
</html>