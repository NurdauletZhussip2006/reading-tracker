<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found | Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page">
    <main class="card error-card">
      <img src="/images/404-illustration.png" alt="Illustration of an open book with a torn page" class="error-illustration-img">

      <p class="error-message">
        We looked between the covers of <code><%= path %></code> and couldn't find a single page.
      </p>

      <a href="/" class="btn-primary error-btn">Back to the Library</a>
    </main>
  </div>
</body>
</html>