<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Find Libraries | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
</head>
<body>
  <div class="page page-wide">
    <header class="site-header">
      <h1>📍 Find Libraries</h1>
      <p class="subtitle">Locate real libraries near any place.</p>
    </header>

    <form id="libraryForm" class="book-search-bar">
      <input type="text" id="libraryInput" placeholder="e.g. Astana" required>
      <button type="submit" class="btn-primary">Find</button>
    </form>


    <div id="libraryStatus" class="status-area"></div>
    <div id="libraryResolvedLocation" class="resolved-location"></div>
    <div id="libraryResults" class="library-list"></div>

    <nav class="site-nav">
      <a href="/search">Discover</a>
      <a href="/">Reading Plan</a>
    </nav>
  </div>

  <script src="/js/libraries-search.js"></script>
  <script src="/js/navGate.js"></script>
</body>
</html>