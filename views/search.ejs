<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Discover | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
</head>
<body>
  <div class="page page-wide">
    <header class="site-header">
      <div class="auth-bar">
        <div id="authStatus" class="auth-status"></div>
      </div>
      <h1>Reading Tracker</h1>
      <p class="subtitle">Estimate how long it'll take you to finish your book.</p>
    </header>
    <div class="hub-grid">
      <a href="/search/best-sellers" class="card hub-card hub-card-featured">
        <span class="hub-icon">📈</span>
        <div>
          <h2>Trending Now</h2>
          <p>See current NYT best-seller lists — updated weekly.</p>
        </div>
      </a>

      <a href="/search/books" class="card hub-card">
        <span class="hub-icon">📚</span>
        <h2>Search Books</h2>
        <p>Find books by title across millions of records.</p>
      </a>

      <a href="/search/authors" class="card hub-card">
        <span class="hub-icon">✍️</span>
        <h2>Author Info</h2>
        <p>Read a biography for any author, in your language.</p>
      </a>

      <a href="/search/dictionary" class="card hub-card">
        <span class="hub-icon">📖</span>
        <h2>Word Lookup</h2>
        <p>Look up definitions in multiple languages.</p>
      </a>

      <a href="/search/libraries" class="card hub-card">
        <span class="hub-icon">📍</span>
        <h2>Find Libraries</h2>
        <p>Locate real libraries near any place.</p>
      </a>
    </div>

    <nav class="site-nav">
      <a href="/">Back to Reading Plan</a>
      <a href="/dashboard">Dashboard</a>
    </nav>
  </div>
  <script src="/js/authFetch.js"></script>
  <script src="/js/authStatus.js"></script>
</body>
</html>
