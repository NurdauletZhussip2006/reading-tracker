<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
</head>
<body>
  <div class="page">
    <header class="site-header">
      <h1>Create an Account</h1>
      <p class="subtitle">Register as a reader or librarian.</p>
    </header>

    <main class="card">
      <form id="registerForm">
        <div class="form-group">
          <label for="regEmail">Email</label>
          <input type="email" id="regEmail" required>
        </div>
        <div class="form-group">
          <label for="regPassword">Password</label>
          <input type="password" id="regPassword" required>
          <small>At least 8 characters, with a letter, number, and special character.</small>
        </div>
        <div class="form-group">
          <label for="regRole">Role</label>
          <select id="regRole">
            <option value="reader">Reader</option>
            <option value="librarian">Librarian</option>
          </select>
        </div>
        <div class="form-group" id="librarianCodeGroup" style="display:none;">
          <label for="regLibrarianCode">Librarian Signup Code</label>
          <input type="text" id="regLibrarianCode" placeholder="Provided by your administrator">
          <small>Librarian accounts require an invite code and cannot be self-assigned otherwise.</small>
        </div>
        <button type="submit" class="btn-primary">Register</button>
      </form>
      <div id="registerStatus" class="status-area"></div>
      <p style="margin-top:1rem;">Already have an account? <a href="/login">Log in</a></p>
    </main>
  </div>

  <script src="/js/auth-helper.js"></script>
  <script src="/js/register.js"></script>
</body>
</html>