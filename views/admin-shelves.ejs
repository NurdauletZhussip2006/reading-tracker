<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Shelves | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="page page-wide">
    <div class="auth-bar"><div id="authStatus" class="auth-status"></div></div>
    <header class="site-header">
      <h1>🗄️ Manage Shelves</h1>
      <p class="subtitle">Full CRUD interface for book shelves. Librarian access required for changes.</p>
    </header>

    <section class="card">
      <h2 id="shelfFormTitle">Create a New Shelf</h2>
      <form id="shelfForm" class="admin-form">
        <input type="hidden" id="shelfFormId">

        <div class="form-group">
          <label for="shelfName">Shelf Name</label>
          <input type="text" id="shelfName" required>
        </div>

        <div class="form-group">
          <label for="shelfBookIds">Books (hold Ctrl/Cmd to select multiple)</label>
          <select id="shelfBookIds" multiple size="8"></select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary" id="shelfFormSubmit">Create Shelf</button>
          <button type="button" class="btn-secondary" id="shelfFormCancel" style="display:none;">Cancel Edit</button>
        </div>
      </form>
      <div id="shelfFormStatus" class="status-area"></div>
    </section>

    <section class="card">
      <h2>All Shelves</h2>
      <div id="adminShelvesStatus" class="status-area"></div>
      <div id="adminShelvesList" class="admin-table"></div>
    </section>

    <nav class="site-nav">
      <a href="/">Reading Plan</a>
      <a href="/admin/books">Book Catalogue</a>
      <a href="/admin/reading-logs">Reading Logs</a>
      <a href="/admin/reviews">Reviews</a>
      <a href="/dashboard">Dashboard</a>
    </nav>
  </div>
  <script src="/js/authFetch.js"></script>
  <script src="/js/authStatus.js"></script>
  <script src="/js/admin-shelves.js"></script>
</body>
</html>