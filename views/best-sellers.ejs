<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trending Now | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
</head>
<body>
  <div class="page page-wide">
    <header class="bestsellers-hero">
      <h1>📈 Trending Now</h1>
      <p class="subtitle">Current New York Times best-seller lists.</p>
    </header>

    <div class="list-picker-bar">
      <div class="list-picker-select-wrap">
        <label for="listSelect">Choose a list</label>
        <select id="listSelect">
          <option value="hardcover-fiction">Hardcover Fiction</option>
          <option value="hardcover-nonfiction">Hardcover Nonfiction</option>
          <option value="trade-fiction-paperback">Paperback Fiction</option>
          <option value="young-adult-hardcover">Young Adult</option>
          <option value="business-books">Business</option>
          <option value="science">Science</option>
          <option value="sports">Sports</option>
          <option value="graphic-books-and-manga">Graphic Books & Manga</option>
          <option value="advice-how-to-and-miscellaneous">Advice, How-To & Misc</option>
          <option value="picture-books">Picture Books</option>
        </select>
      </div>
      <button id="loadListBtn" class="btn-primary">Load List</button>
    </div>

    <div id="bestSellersStatus" class="status-area"></div>
    <div id="bestSellersUpdated" class="resolved-location"></div>

    <div id="podium" class="podium"></div>
    <div id="bestSellersResults" class="rank-list"></div>

    <nav class="site-nav">
      <a href="/search">Discover</a>
      <a href="/">Reading Plan</a>
    </nav>
  </div>

  <script src="/js/best-sellers.js"></script>
</body>
</html>