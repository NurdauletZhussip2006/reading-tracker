<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Word Lookup | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
</head>
<body>
  <div class="page page-wide">
    <header class="site-header">
      <h1>📖 Word Lookup</h1>
      <p class="subtitle">Look up definitions in multiple languages.</p>
    </header>

    <form id="dictionaryForm" class="book-search-bar">
      <input type="text" id="dictionaryInput" placeholder="e.g. serendipity" required>
      <button type="submit" class="btn-primary">Define</button>
    </form>

    <div class="language-bar language-bar-inline">
      <label for="languageSelect">Language</label>
      <select id="languageSelect">
        <% SUPPORTED_LANGUAGES.forEach(function(lang) { %>
          <option value="<%= lang.code %>"><%= lang.name %></option>
        <% }); %>
      </select>
    </div>

    <div id="dictionaryStatus" class="status-area"></div>
    <div id="dictionaryResult"></div>

    <nav class="site-nav">
      <a href="/search">Discover</a>
      <a href="/">Reading Plan</a>
    </nav>
  </div>

  <script src="/js/dictionary-search.js"></script>
</body>
</html>