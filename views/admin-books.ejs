<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Books | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="page page-wide">
    <header class="site-header">
      <h1>📚 Manage Books</h1>
      <p class="subtitle">Full book catalog.</p>
    </header>

    <section class="card">
      <h2 id="formTitle">Add a New Book</h2>
      <form id="bookForm" class="admin-form">
        <input type="hidden" id="bookFormId">

        <div class="form-row">
          <div class="form-group">
            <label for="bookTitle">Title</label>
            <input type="text" id="bookTitle" required>
          </div>
          <div class="form-group">
            <label for="bookIsbn">ISBN</label>
            <input type="text" id="bookIsbn">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="bookAuthors">Authors</label>
            <input type="text" id="bookAuthors" placeholder="e.g. Frank Herbert, Brian Herbert" required>
          </div>
          <div class="form-group">
            <label for="bookGenres">Genres</label>
            <input type="text" id="bookGenres" placeholder="e.g. Science Fiction, Classics">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group form-group-small">
            <label for="bookPages">Pages</label>
            <input type="number" id="bookPages" min="1" required>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary" id="bookFormSubmit">Create Book</button>
          <button type="button" class="btn-secondary" id="bookFormCancel" style="display:none;">Cancel Edit</button>
        </div>
      </form>
      <div id="bookFormStatus" class="status-area"></div>
    </section>

    <section class="card">
        <div class="admin-list-header">
          <h2>All Books</h2>
        </div>

        <div class="admin-list-controls">
          <div class="control-group">
            <label for="bookGenreFilter">Filter by genre</label>
            <select id="bookGenreFilter">
              <option value="">All Genres</option>
            </select>
          </div>
          <div class="control-group control-group-search">
            <label for="bookSearchFilter">Search</label>
            <input type="text" id="bookSearchFilter" placeholder="Title or author...">
          </div>
        </div>
      <div id="adminBooksStatus" class="status-area"></div>
      <div id="adminBooksList" class="admin-table"></div>
    </section>

    <nav class="site-nav">
      <a href="/">Reading Plan</a>
      <a href="/reading-tips">Reading Tips</a>
      <a href="/search">Discover</a>
      <a href="/admin/reading-logs">Reading Logs</a>
    </nav>
  </div>

  <script src="/js/admin-books.js"></script>
</body>
</html>