<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Reviews | Digital Library & Reading Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/search.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="page page-wide">
    <div class="auth-bar"><div id="authStatus" class="auth-status"></div></div>
    <header class="site-header">
      <h1>⭐ Manage Reviews</h1>
      <p class="subtitle">Full CRUD interface for book reviews.</p>
    </header>

    <section class="card">
      <h2 id="reviewFormTitle">Write a Review</h2>
      <form id="reviewForm" class="admin-form">
        <input type="hidden" id="reviewFormId">

        <div class="form-row">
          <div class="form-group">
            <label for="reviewBookId">Book</label>
            <select id="reviewBookId" required>
              <option value="">Select a book...</option>
            </select>
          </div>
          <div class="form-group form-group-small">
            <label for="reviewRating">Rating (0-5)</label>
            <input type="number" id="reviewRating" min="0" max="5" required>
          </div>
        </div>

        <div class="form-group">
          <label for="reviewText">Review Text (optional)</label>
          <input type="text" id="reviewText" placeholder="What did you think?">
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary" id="reviewFormSubmit">Submit Review</button>
          <button type="button" class="btn-secondary" id="reviewFormCancel" style="display:none;">Cancel Edit</button>
        </div>
      </form>
      <div id="reviewFormStatus" class="status-area"></div>
    </section>

    <section class="card">
      <h2>All Reviews</h2>
      <div class="admin-list-controls">
        <div class="control-group">
          <label for="reviewRatingFilter">Filter by rating</label>
          <select id="reviewRatingFilter">
            <option value="">All Ratings</option>
            <option value="5">5</option>
            <option value="4">4</option>
            <option value="3">3</option>
            <option value="2">2</option>
            <option value="1">1</option>
            <option value="0">0</option>
          </select>
        </div>
      </div>
      <div id="adminReviewsStatus" class="status-area"></div>
      <div id="adminReviewsList" class="admin-table"></div>
    </section>

    <nav class="site-nav">
      <a href="/search">Discover</a>
      <a href="/admin/books">Book Catalogue</a>
      <a href="/admin/reading-logs">Reading Logs</a>
      <a href="/admin/reviews">Reviews</a>
      <a href="/admin/shelves">Shelves</a>
      <a href="/dashboard">Dashboard</a>
    </nav>
  </div>
  <script src="/js/authFetch.js"></script>
  <script src="/js/navGate.js"></script>
  <script src="/js/authStatus.js"></script>
  <script src="/js/admin-reviews.js"></script>
</body>
</html>